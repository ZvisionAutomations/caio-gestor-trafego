# Caio — Variáveis de Ambiente
# Copie para .env e preencha com os valores reais
# NUNCA commite o .env com valores reais

# ── Meta Ads API ───────────────────────────────────────────────────────────
META_APP_ID=                      # Obtido no Meta Business Manager
META_APP_SECRET=                  # Obtido no Meta Business Manager
META_ACCESS_TOKEN=                # User token com ads_management + ads_read
META_ACCOUNT_ID=                  # act_XXXXXXXXXXXXXXX (com prefixo act_)

# ── Evolution API (WhatsApp) ───────────────────────────────────────────────
EVOLUTION_API_URL=                # https://sua-vps.com:8080
EVOLUTION_API_KEY=                # Chave da Evolution API
EVOLUTION_INSTANCE=               # Nome da instância configurada
WHATSAPP_GROUP_ID=                # ID do grupo Raiz Vital (obter via Evolution API)

# ── LLM ────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=                # Cérebro Claude Haiku 4.5 (tool-calling + decisões)
GOOGLE_API_KEY=                   # Músculo Gemini 2.5 Flash-Lite (texto puro). Opcional —
                                  # sem esta chave, tarefas de músculo caem no cérebro Claude

# ── Business Signal (leitura read-only do Postgres do zwaf) ──────────────────
# Role read-only caio_ro. SEM esta var, a trava de escala BLOQUEIA duplicação
# (lado seguro). Setar só no deploy do agente, via nano (nunca no chat).
CAIO_DATABASE_URL=                # postgresql://caio_ro:<senha>@zwaf-postgres-1:5432/zwaf_raiz_vital
CAIO_SIGNAL_TENANT_ID=            # tenant do sinal de atribuição (ex. livia-raiz-vital). Vazio = bloqueia escala

# ── Configuração ───────────────────────────────────────────────────────────
SETTINGS_PATH=config/settings.yaml

# ── Ambiente ───────────────────────────────────────────────────────────────
ENVIRONMENT=production            # development | production
LOG_LEVEL=INFO
